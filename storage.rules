rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToAcademia(academiaId) {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.academiaId == academiaId;
    }

    match /academias/{academiaId}/{allPaths=**} {
      allow read: if belongsToAcademia(academiaId);
      allow write: if belongsToAcademia(academiaId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
